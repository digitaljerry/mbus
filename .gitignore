# Repo-wide. Each app has its own .gitignore too (apps/web/.gitignore).
node_modules/
.DS_Store
.env*
!.env.example
*.pem
.vercel

# Xcode / Swift (apps/apple)
xcuserdata/
DerivedData/
.build/
*.xcuserstate

# Android / Gradle (apps/android)
.gradle/
local.properties
*.iml

# Next.js output when run from the repo root by mistake (the app lives in apps/web)
/.next/
/next-env.d.ts
/tsconfig.tsbuildinfo
