{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "packages": [
    {
      "kind": "local",
      "path": "MBusKit",
    },
  ],
  "files": [
    { "kind": "folder", "path": "MBus", "target-membership": [ "MBus" ] },
    { "kind": "folder", "path": "Shared", "target-membership": [ "MBus", "MBusWidgets" ] },
    { "kind": "folder", "path": "MBusWidgets", "target-membership": [ "MBusWidgets" ] },
    { "kind": "folder", "path": "MBusWatch", "target-membership": [ "MBusWatch" ] },
    { "kind": "folder", "path": "MBusWatchWidgets", "target-membership": [ "MBusWatchWidgets" ] },
    { "kind": "folder", "path": "Config" },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/MBus.app", "id": "B0000000000000000000000B", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/MBusWidgets.appex", "id": "B0000000000000000000000C", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "MBus/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/MBusWatch.app", "id": "B0000000000000000000000D", "type": "wrapper.application", "index": false, "target-membership": [ { "build-phase": "MBus/copy/Embed Watch Content", "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/MBusWatchWidgets.appex", "id": "B0000000000000000000000E", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "MBusWatch/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
      ],
    },
  ],
  "targets": [
    {
      "name": "MBus",
      "id": "B00000000000000000000019",
      "product": "Products/MBus.app",
      "product-type": "application",
      "dependencies": [
        "MBusWidgets",
        "MBusWatch",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        }, {
          "kind": "copy",
          "name": "Embed Watch Content",
          "bundle-base-path": "build-products-directory",
          "relative-path": "$(CONTENTS_FOLDER_PATH)/Watch",
        },
      ],
      "package-product-members": [
        {
          "package": "MBusKit",
          "product-name": "MBusKit",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "MBusKit",
          "product-name": "MBusUI",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CODE_SIGN_ENTITLEMENTS": "Config/MBus.entitlements",
        "ENABLE_APP_SANDBOX": "NO",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "Config/MBus-Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "MBus",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.navigation",
        "INFOPLIST_KEY_NSLocationWhenInUseUsageDescription": "MBus uses your location to show bus stops near you and how long the walk is.",
        "INFOPLIST_KEY_NSSupportsLiveActivities": "YES",
        "INFOPLIST_KEY_NSSupportsLiveActivitiesFrequentUpdates": "YES",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation": "YES",
        "INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation": "YES",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad": "UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone": "UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "dev.zorec.mbus",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SDKROOT": "iphoneos",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator",
        "SUPPORTS_MACCATALYST": "NO",
        "SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "TARGETED_DEVICE_FAMILY": "1,2",
      },
    }, {
      "name": "MBusWidgets",
      "id": "B00000000000000000000024",
      "product": "Products/MBusWidgets.appex",
      "product-type": "app-extension",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "package-product-members": [
        {
          "package": "MBusKit",
          "product-name": "MBusKit",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "MBusKit",
          "product-name": "MBusUI",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "APPLICATION_EXTENSION_API_ONLY": "YES",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "ASSETCATALOG_COMPILER_WIDGET_BACKGROUND_COLOR_NAME": "WidgetBackground",
        "CODE_SIGN_ENTITLEMENTS": "Config/MBusWidgets.entitlements",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "Config/MBusWidgets-Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "MBus",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
          "@executable_path/../../Frameworks",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "dev.zorec.mbus.widgets",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SDKROOT": "iphoneos",
        "SKIP_INSTALL": "YES",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator",
        "SUPPORTS_MACCATALYST": "NO",
        "SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "TARGETED_DEVICE_FAMILY": "1,2",
      },
    }, {
      "name": "MBusWatch",
      "id": "B0000000000000000000002F",
      "product": "Products/MBusWatch.app",
      "product-type": "application",
      "dependencies": [
        "MBusWatchWidgets",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        },
      ],
      "package-product-members": [
        {
          "package": "MBusKit",
          "product-name": "MBusKit",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "MBusKit",
          "product-name": "MBusUI",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CODE_SIGN_ENTITLEMENTS": "Config/MBusWatch.entitlements",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "Config/MBusWatch-Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "MBus",
        "INFOPLIST_KEY_NSLocationWhenInUseUsageDescription": "MBus uses your location to show bus stops near you.",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations": "UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown",
        "INFOPLIST_KEY_WKCompanionAppBundleIdentifier": "dev.zorec.mbus",
        "INFOPLIST_KEY_WKRunsIndependentlyOfCompanionApp": "YES",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "dev.zorec.mbus.watchkitapp",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SDKROOT": "watchos",
        "SKIP_INSTALL": "YES",
        "SUPPORTED_PLATFORMS": "watchos watchsimulator",
        "TARGETED_DEVICE_FAMILY": "4",
      },
    }, {
      "name": "MBusWatchWidgets",
      "id": "B0000000000000000000003A",
      "product": "Products/MBusWatchWidgets.appex",
      "product-type": "app-extension",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "package-product-members": [
        {
          "package": "MBusKit",
          "product-name": "MBusKit",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "MBusKit",
          "product-name": "MBusUI",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "APPLICATION_EXTENSION_API_ONLY": "YES",
        "CODE_SIGN_ENTITLEMENTS": "Config/MBusWatchWidgets.entitlements",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "Config/MBusWatchWidgets-Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "MBus",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
          "@executable_path/../../Frameworks",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "dev.zorec.mbus.watchkitapp.widgets",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SDKROOT": "watchos",
        "SKIP_INSTALL": "YES",
        "SUPPORTED_PLATFORMS": "watchos watchsimulator",
        "TARGETED_DEVICE_FAMILY": "4",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
    "ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS": "YES",
    "CLANG_ENABLE_MODULES": "YES",
    "CLANG_ENABLE_OBJC_ARC": "YES",
    "CODE_SIGN_STYLE": "Automatic",
    "COPY_PHASE_STRIP": "NO",
    "CURRENT_PROJECT_VERSION": "1",
    "DEAD_CODE_STRIPPING": "YES",
    "DEBUG_INFORMATION_FORMAT[config=Debug]": "dwarf",
    "DEBUG_INFORMATION_FORMAT[config=Release]": "dwarf-with-dsym",
    "DEVELOPMENT_TEAM": "",
    "ENABLE_PREVIEWS": "YES",
    "ENABLE_STRICT_OBJC_MSGSEND": "YES",
    "ENABLE_TESTABILITY[config=Debug]": "YES",
    "ENABLE_USER_SCRIPT_SANDBOXING": "YES",
    "GCC_C_LANGUAGE_STANDARD": "gnu17",
    "GCC_OPTIMIZATION_LEVEL[config=Debug]": "0",
    "IPHONEOS_DEPLOYMENT_TARGET": "26.0",
    "LOCALIZATION_PREFERS_STRING_CATALOGS": "YES",
    "MARKETING_VERSION": "1.0",
    "ONLY_ACTIVE_ARCH[config=Debug]": "YES",
    "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
    "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": "DEBUG $(inherited)",
    "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
    "SWIFT_COMPILATION_MODE[config=Release]": "wholemodule",
    "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
    "SWIFT_EMIT_LOC_STRINGS": "YES",
    "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
    "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
    "SWIFT_VERSION": "6.0",
    "VALIDATE_PRODUCT[config=Release]": "YES",
    "WATCHOS_DEPLOYMENT_TARGET": "26.0",
  },
  "last-upgrade": "27.0",
  "last-swift-update": "27.0",
}
